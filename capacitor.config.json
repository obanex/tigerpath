{
  "appId": "io.github.obanex.tigerpath",
  "appName": "TU TigerPath",
  "webDir": "dist",
  "backgroundColor": "#111111",
  "ios": {
    "contentInset": "never",
    "scheme": "TigerPath",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 500, "backgroundColor": "#111111", "showSpinner": false },
    "LocalNotifications": { "iconColor": "#FFBB00" }
  }
}
